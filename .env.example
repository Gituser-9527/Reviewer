HOST=0.0.0.0
PORT=3001
API_BASE_URL=http://localhost:3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_compliance_agent
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5433/job_compliance_test
NODE_ENV=development
LOG_LEVEL=info

# LLM provider is optional. Tests and local MVP flows use mock/fallback behavior.
LLM_PROVIDER=mock
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# 32-byte base64 value; leave empty in source control and provide via secret manager.
LLM_SECRET_ENCRYPTION_KEY=
LLM_SECRET_ENCRYPTION_KEY_VERSION=env-v1

# Privacy defaults: raw text should not be persisted in logs unless explicitly enabled.
ALLOW_UNREDACTED_RAW_TEXT=false
