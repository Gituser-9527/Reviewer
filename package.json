{
  "name": "job-compliance-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the job compliance audit agent.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build:packages && npm run build --workspace @job-compliance/api && npm run build --workspace @job-compliance/web",
    "build:packages": "npm run build --workspace @job-compliance/shared && npm run build --workspace @job-compliance/core && npm run build --workspace @job-compliance/database",
    "db:migrate": "npm run migrate --workspace @job-compliance/database",
    "test:db:up": "powershell -ExecutionPolicy Bypass -File scripts/test-db.ps1 up",
    "test:db:down": "powershell -ExecutionPolicy Bypass -File scripts/test-db.ps1 down",
    "test:db:reset": "powershell -ExecutionPolicy Bypass -File scripts/test-db.ps1 reset",
    "test:db:wait": "powershell -ExecutionPolicy Bypass -File scripts/test-db.ps1 wait",
    "test:db:migrate": "powershell -ExecutionPolicy Bypass -File scripts/run-with-test-env.ps1 npm run db:migrate",
    "doctor:test-db": "powershell -ExecutionPolicy Bypass -File scripts/doctor-test-db.ps1",
    "doctor:internal-alpha": "node scripts/internal-alpha-doctor.mjs",
    "doctor:internal-alpha-readiness": "node scripts/internal-alpha-readiness-doctor.mjs",
    "alpha:local-smoke": "node scripts/internal-alpha-local-smoke.mjs",
    "test:postgres": "powershell -ExecutionPolicy Bypass -File scripts/run-with-test-env.ps1 npx vitest run --config vitest.postgres.config.ts packages/database/src/repository.integration.test.ts",
    "dev:api": "npm run build:packages && npm run dev --workspace @job-compliance/api",
    "dev:web": "npm run build:packages && npm run dev --workspace @job-compliance/web",
    "eval": "npm run build:packages && tsx --conditions=import evals/run-eval.ts",
    "eval:redteam": "npm run build:packages && tsx --conditions=import evals/run-red-team.ts",
    "eval:real": "npm run build:packages && tsx --conditions=import evals/run-real-eval.ts",
    "eval:dataset": "npm run build:packages && tsx --conditions=import evals/run-dataset-eval.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run build:packages && vitest run && node --test scripts/internal-alpha-doctor.test.mjs scripts/internal-alpha-readiness-doctor.test.mjs scripts/internal-alpha-local-smoke.test.mjs",
    "test:watch": "vitest",
    "test:settings": "vitest run apps/api/src/settings",
    "test:llm": "vitest run packages/core/src/llm packages/core/src/security/secret-encryption.test.ts",
    "test:beta-stability": "vitest run apps/api/src/beta-program/routes.test.ts",
    "test:audit-routing": "vitest run packages/core/src/orchestrator",
    "test:enrichment-worker": "vitest run apps/api/src/audit",
    "test:async-jobs": "vitest run apps/api/src/audit/enrichment-worker.test.ts",
    "test:production-enrichment": "vitest run apps/api/src/audit/enrichment-worker.test.ts apps/api/src/audit/rewrite-safety.test.ts apps/api/src/audit/enrichment-api.test.ts apps/api/src/audit/rewrite-secondary-review.test.ts",
    "test:production-enrichment:postgres": "powershell -ExecutionPolicy Bypass -File scripts/run-with-test-env.ps1 powershell -ExecutionPolicy Bypass -File scripts/run-production-enrichment-postgres.ps1",
    "worker:enrichment": "tsx apps/api/src/audit/enrichment-worker.ts",
    "worker:enrichment:once": "tsx apps/api/src/audit/enrichment-worker.ts --once",
    "test:ui": "vitest run apps/web",
    "build:extension": "npm run build --workspace @job-compliance/extension",
    "test:extension": "vitest run apps/extension/src",
    "test:extension:e2e": "npm run build:extension && node apps/extension/e2e/capture-audit.e2e.mjs",
    "test:extension:local-api:postgres": "powershell -ExecutionPolicy Bypass -File scripts/run-extension-local-api-postgres-e2e.ps1",
    "test:alpha:local-smoke": "node --test scripts/internal-alpha-local-smoke.test.mjs",
    "check:i18n": "npm run build --workspace @job-compliance/web",
    "typecheck": "npm run build:packages && npm run typecheck --workspace @job-compliance/api && npm run typecheck --workspace @job-compliance/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
